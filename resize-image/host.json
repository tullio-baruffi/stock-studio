{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "concurrency": {
    "dynamicConcurrencyEnabled": false,
    "snapshotPersistenceEnabled": true
  },
  "extensions": {
    "queues": {
      "visibilityTimeout": "00:01:00",
      "batchSize": 1,
      "newBatchThreshold": 0
    }
  }
}