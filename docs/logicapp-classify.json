                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "patch",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://cosdh.sharepoint.com/sites/Classifier'))}/tables/@{encodeURIComponent(encodeURIComponent('55d41a6e-e3fb-4135-a727-c3b3da057cd1'))}/items/@{encodeURIComponent(body('Parse_Queue_message')?['IdSharePoint'])}/patchfileitem"
