                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Update_file_properties": [
                  "Succeeded"
                ]
              },
              "type": "Terminate"
            },
            "Update_file_properties": {
              "inputs": {
                "body": {
                  "OData__ExtendedDescription": "@body('Parse_OpenAI_Content_Response')?['description']",
                  "Stato": "REVISIONE: Metadati estratti dall'immagine",
                  "Tags": "@{join(body('Parse_OpenAI_Content_Response')?['keywords'],',')}",
                  "Title": "@body('Parse_OpenAI_Content_Response')?['title']"
                },
