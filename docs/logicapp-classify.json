                "inputs": {
                  "runError": {
                    "code": "@{variables('HttpResponseCode')}",
                    "message": "@{variables('OpenAiResponse')}"
                  },
                  "runStatus": "Failed"
                },
                "runAfter": {
                  "Update_Stato_in_Errore": [
