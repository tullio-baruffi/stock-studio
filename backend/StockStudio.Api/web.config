<?xml version="1.0" encoding="utf-8"?>
<!--
  Il tetto sulla dimensione delle richieste che IIS applica prima dell'applicazione.

  Di serie vale 30.000.000 byte, e lo applica la piattaforma prima del login e prima del codice:
  il RequestSizeLimit scritto sul controller sta piu' a valle e non lo puo' alzare. Misurato in
  produzione l'11/10/2026: 30.000.000 byte passavano, 30.000.001 tornavano 413 da IIS, e trenta
  immagini consegnate insieme non arrivavano in pipeline.

  La pagina ora consegna a lotti da meno di 24 MB (frontend/src/lotti.ts), quindi questo valore
  serve per un caso solo: una singola immagine piu' grande di 28 MB, che non si puo' spezzare.
  E' allineato agli altri due tetti, che devono restare uguali o ne comanda il piu' basso:
  [RequestSizeLimit] in JobsController e MaxRequestBodySize/MultipartBodyLengthLimit in Program.cs.

  La pubblicazione fonde questo file con quello che genera da se' (il gestore aspNetCore), quindi
  qui ci va solo quel che si aggiunge.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="500000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
