{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Vectorize": {
    "Engine": "opensource",
    "PotracePath": "tools/potrace/potrace.exe",
    "AutoThreshold": true,
    "Threshold": 128,
    "InvertIfMostlyDark": true,
    "TurdSize": 2,
    "AlphaMax": 1.0,
    "OptTolerance": 0.2,
    "JpegLongEdge": 4000,
    "JpegQuality": 92
  },
  "Ai": {
    "Provider": "stub",
    "Model": "gpt-4o-mini",
    "ApiVersion": "2024-08-01-preview",
    "ImageMaxEdge": 1024,
    "MaxKeywords": 40,
    "Temperature": 0.4
  },
  "Pipeline": {
    "Enabled": false,
    "SiteUrl": "https://cosdh.sharepoint.com/sites/Classifier",
    "Tenant": "cosdh.onmicrosoft.com",
    "LibraryFolder": "/sites/Classifier/ImagesToClassify",
    "QueueName": "image-to-classify",
    "DispatchFile": "auto"
  },
  "Tables": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "TableName": "stockstudiojobs"
  },
  "Plan": {
    "Enabled": false,
    "PlanName": "asp-stock-api-001",
    "SiteName": "stock-vector-studio-api",
    "UpSku": "B1",
    "CpuThresholdPercent": 80,
    "CheckMinutes": 10,
    "AutoScaleUp": true
  },
  "KeyVault": {
    "Uri": ""
  }
}
