<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared contracts used by BOTH the Azure Functions app (resize-image, net6.0-windows)
    and the Web API (StockStudio.Api, net8.0). Targets netstandard2.0 so either can reference it.
    Keep this library dependency-light and framework-agnostic (POCOs/contracts only).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StockStudio.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
